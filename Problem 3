using System;
using System.Collections.Generic;

namespace ClassProject_3
{
    // Structure for each student request
    struct StudentRequest
    {
        public string StudentNumber;
        public string StudentName;
        public string RequestType;
    }

    class Program
    {
        // Queue that follows FIFO (First In, First Out)
        static Queue<StudentRequest> requestQueue = new Queue<StudentRequest>();

        static void Main(string[] args)
        {
            int choice;

            do
            {
                Console.Clear();
                Console.WriteLine("===== STUDENT REQUEST QUEUE =====");
                Console.WriteLine("1. Add Request");
                Console.WriteLine("2. View Pending Requests");
                Console.WriteLine("3. Process Request");
                Console.WriteLine("4. Exit");
                Console.Write("Enter your choice: ");

                if (!int.TryParse(Console.ReadLine(), out choice))
                {
                    Console.WriteLine("Invalid input. Please enter a number.");
                    Console.WriteLine("Press any key to continue...");
                    Console.ReadKey();
                    continue;
                }

                switch (choice)
                {
                    case 1:
                        AddRequest();
                        break;
                    case 2:
                        ViewPendingRequests();
                        break;
                    case 3:
                        ProcessRequest();
                        break;
                    case 4:
                        Console.WriteLine("Exiting program... Goodbye!");
                        break;
                    default:
                        Console.WriteLine("Invalid choice. Please select 1-4.");
                        break;
                }

                if (choice != 4)
                {
                    Console.WriteLine("\nPress any key to continue...");
                    Console.ReadKey();
                }

            } while (choice != 4);
        }

        static string ReadInput(string prompt)
        {
            Console.Write(prompt);
            return (Console.ReadLine() ?? "").Trim();
        }

        // 1. Add Request (Enqueue)
        static void AddRequest()
        {
            Console.WriteLine("\n--- Add Student Request ---");

            StudentRequest request = new StudentRequest();

            request.StudentNumber = ReadInput("Enter Student Number: ");
            request.StudentName = ReadInput("Enter Student Name: ");
            request.RequestType = ReadInput("Enter Request Type (e.g. Certificate of Enrollment, Student ID, Transcript Request): ");

            // Add to the queue (goes to the back)
            requestQueue.Enqueue(request);

            Console.WriteLine("Request added successfully!");
        }

        // 2. View Pending Requests
        static void ViewPendingRequests()
        {
            Console.WriteLine("\n--- Pending Requests ---");

            if (requestQueue.Count == 0)
            {
                Console.WriteLine("No pending requests.");
                return;
            }

            Console.WriteLine("{0,-15} {1,-25} {2,-30}", "Student Number", "Student Name", "Request Type");
            Console.WriteLine(new string('-', 70));

            // Display from first (oldest) to last (newest)
            foreach (var request in requestQueue)
            {
                Console.WriteLine("{0,-15} {1,-25} {2,-30}",
                    request.StudentNumber,
                    request.StudentName,
                    request.RequestType);
            }
        }

        // 3. Process Request (Dequeue - removes the oldest one)
        static void ProcessRequest()
        {
            Console.WriteLine("\n--- Process Request ---");

            if (requestQueue.Count == 0)
            {
                Console.WriteLine("No pending requests to process.");
                return;
            }

            // Remove the first request (FIFO)
            StudentRequest processed = requestQueue.Dequeue();

            Console.WriteLine("Request processed successfully!");
            Console.WriteLine("Processed Request Details:");
            Console.WriteLine("Student Number : " + processed.StudentNumber);
            Console.WriteLine("Student Name   : " + processed.StudentName);
            Console.WriteLine("Request Type   : " + processed.RequestType);
        }
    }
}
